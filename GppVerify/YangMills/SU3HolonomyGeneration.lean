import Mathlib.Algebra.Lie.Subalgebra
import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.LinearAlgebra.Matrix.Trace
import Mathlib.Data.Complex.Basic
import Mathlib.Analysis.Complex.Basic
import Mathlib.Data.Matrix.Basic
import Mathlib.Tactic.FinCases

/-!
# Two curvature values generate `su(3)`: the finite core of the full-holonomy construction

Discovery 2 (PR #11, comment 6888041210; GPPDiscovery2 `codex/discovery-workbench` 3961308, check
0605d83) builds, on every Grassmannian-derived `SU(3)` bundle `P_{3,k} → S⁴` (`c₂ = k`), a connection
with full restricted holonomy `SU(3)`: the local field `A = X x¹dx² + Y x³dx⁴` has curvature values
`X, Y` at the centre of a ball, and by Ambrose–Singer the holonomy algebra contains the Lie algebra
they generate. Turbo audited it at paper level (bridge CONVERSATION.md, 2026-11-15, PASS).

**What is proved here** is the algebraic step, exactly. With

  `X = i·diag(1, 2, -3)`,  `Y = i(E₁₂ + E₂₁ + E₂₃ + E₃₂)`,

and `su(3)` the real Lie subalgebra of traceless skew-Hermitian `3 × 3` complex matrices (`su3`):

* **`lieSpan_XY_eq_su3`**: the real Lie subalgebra of `M₃(ℂ)` generated by `X` and `Y` is all of
  `su(3)`;
* `adX_sq_Y`: `[X, [X, Y]] = -Y₁₂ - 25 Y₂₃` — the eigenvalues `-1, -25` of `(ad X)²` that separate the
  two simple-root pieces of `Y`.

The eight basis elements are written as explicit iterated brackets of `X` and `Y` (`Y₁₂`, `Y₂₃` from
`(ad X)²`; `[X, Y₁₂]`, `[X, Y₂₃]`; `[Y₁₂, Y₂₃]`, `[Y₁₂, [X, Y₂₃]]`; `[Y₁₂, [X, Y₁₂]]` with `X` for the
Cartan part), and every element of `su(3)` is an explicit real combination of them (`mem_lieSpan_of_su3`).

**Not formalised here:** connections, curvature on `S⁴`, the cutoff gluing, Ambrose–Singer (Mathlib has
no holonomy theory), and the Chern–Weil transgression. Nothing here derives colour dynamics, and
nothing concerns the Riemann hypothesis. No `sorry`, no axioms.
-/

namespace GppSU3Holonomy

open Matrix Complex

abbrev M3 := Matrix (Fin 3) (Fin 3) ℂ

attribute [local instance 100] LieRing.ofAssociativeRing

/-! ### `su(3)` as a real Lie subalgebra -/

/-- Traceless skew-Hermitian `3 × 3` matrices. -/
def su3 : LieSubalgebra ℝ M3 where
  carrier := {A | Aᴴ = -A ∧ A.trace = 0}
  add_mem' := by
    rintro A B ⟨hA, tA⟩ ⟨hB, tB⟩
    exact ⟨by rw [conjTranspose_add, hA, hB, neg_add], by rw [trace_add, tA, tB, add_zero]⟩
  zero_mem' := ⟨by simp, by simp⟩
  smul_mem' := by
    rintro c A ⟨hA, tA⟩
    refine ⟨?_, ?_⟩
    · rw [conjTranspose_smul, hA, smul_neg]
      congr 1
    · rw [trace_smul, tA, smul_zero]
  lie_mem' := by
    rintro A B ⟨hA, -⟩ ⟨hB, -⟩
    refine ⟨?_, ?_⟩
    · rw [Ring.lie_def, conjTranspose_sub, conjTranspose_mul, conjTranspose_mul, hA, hB]
      simp only [neg_mul_neg]
      abel
    · rw [Ring.lie_def, trace_sub, trace_mul_comm, sub_self]

/-! ### The generators and the eight brackets -/

def X : M3 := !![I, 0, 0; 0, 2 * I, 0; 0, 0, -3 * I]
def Y : M3 := !![0, I, 0; I, 0, I; 0, I, 0]

def Y12 : M3 := !![0, I, 0; I, 0, 0; 0, 0, 0]
def Y23 : M3 := !![0, 0, 0; 0, 0, I; 0, I, 0]
def A12 : M3 := !![0, 1, 0; -1, 0, 0; 0, 0, 0]
def A23 : M3 := !![0, 0, 0; 0, 0, 1; 0, -1, 0]
def A13 : M3 := !![0, 0, 1; 0, 0, 0; -1, 0, 0]
def S13 : M3 := !![0, 0, I; 0, 0, 0; I, 0, 0]
def H1 : M3 := !![-I, 0, 0; 0, I, 0; 0, 0, 0]

/-- Entrywise check of a `3 × 3` matrix identity. -/
macro "m3" : tactic => `(tactic| (ext i j; fin_cases i <;> fin_cases j <;>
  simp [Matrix.mul_apply, Fin.sum_univ_three, X, Y, Y12, Y23, A12, A23, A13, S13, H1] <;>
  ring_nf <;> simp [Complex.ext_iff] <;> norm_num))

theorem adX_sq_Y : ⁅X, ⁅X, Y⁆⁆ = -Y12 - (25 : ℝ) • Y23 := by
  simp only [Ring.lie_def]; m3

theorem Y12_eq : Y12 = (1 / 24 : ℝ) • (⁅X, ⁅X, Y⁆⁆ + (25 : ℝ) • Y) := by
  simp only [Ring.lie_def]; m3

theorem Y23_eq : Y23 = Y - Y12 := by m3

theorem A12_eq : A12 = ⁅X, Y12⁆ := by simp only [Ring.lie_def]; m3

theorem A23_eq : A23 = (-(1 / 5 : ℝ)) • ⁅X, Y23⁆ := by simp only [Ring.lie_def]; m3

theorem A13_eq : A13 = -⁅Y12, Y23⁆ := by simp only [Ring.lie_def]; m3

theorem S13_eq : S13 = ⁅Y12, A23⁆ := by simp only [Ring.lie_def]; m3

theorem H1_eq : H1 = (1 / 2 : ℝ) • ⁅Y12, A12⁆ := by simp only [Ring.lie_def]; m3

/-! ### Membership in the Lie span -/

/-- The Lie subalgebra generated by `X` and `Y`. -/
noncomputable abbrev L : LieSubalgebra ℝ M3 := LieSubalgebra.lieSpan ℝ M3 {X, Y}

theorem X_mem : X ∈ L := LieSubalgebra.subset_lieSpan (by simp)
theorem Y_mem : Y ∈ L := LieSubalgebra.subset_lieSpan (by simp)

theorem Y12_mem : Y12 ∈ L := by
  rw [Y12_eq]
  exact L.smul_mem _ (L.add_mem (L.lie_mem X_mem (L.lie_mem X_mem Y_mem)) (L.smul_mem _ Y_mem))

theorem Y23_mem : Y23 ∈ L := by rw [Y23_eq]; exact L.sub_mem Y_mem Y12_mem
theorem A12_mem : A12 ∈ L := by rw [A12_eq]; exact L.lie_mem X_mem Y12_mem
theorem A23_mem : A23 ∈ L := by rw [A23_eq]; exact L.smul_mem _ (L.lie_mem X_mem Y23_mem)
theorem A13_mem : A13 ∈ L := by rw [A13_eq]; exact L.neg_mem (L.lie_mem Y12_mem Y23_mem)
theorem S13_mem : S13 ∈ L := by rw [S13_eq]; exact L.lie_mem Y12_mem A23_mem
theorem H1_mem : H1 ∈ L := by rw [H1_eq]; exact L.smul_mem _ (L.lie_mem Y12_mem A12_mem)

/-! ### Every element of `su(3)` is a real combination of the eight -/

theorem mem_lieSpan_of_su3 (A : M3) (hA : Aᴴ = -A) (tA : A.trace = 0) : A ∈ L := by
  have e : ∀ i j, star (A j i) = -A i j := fun i j => by
    have := congrFun (congrFun hA i) j; simpa [conjTranspose_apply] using this
  have d : ∀ i, (A i i).re = 0 := fun i => by
    have := congrArg Complex.re (e i i); simp at this; linarith
  have o : ∀ i j, (A j i).re = -(A i j).re ∧ (A j i).im = (A i j).im := fun i j => by
    have h := e i j
    constructor
    · have := congrArg Complex.re h; simp at this; linarith
    · have := congrArg Complex.im h; simp at this; linarith
  have tr : (A 0 0).im + (A 1 1).im + (A 2 2).im = 0 := by
    have := congrArg Complex.im tA
    simpa [Matrix.trace, Fin.sum_univ_three] using this
  have key : A = (((A 1 1).im - 2 * (A 0 0).im) / 3 : ℝ) • H1
      + (((A 0 0).im + (A 1 1).im) / 3 : ℝ) • X
      + (A 0 1).im • Y12 + (A 0 1).re • A12
      + (A 1 2).im • Y23 + (A 1 2).re • A23
      + (A 0 2).im • S13 + (A 0 2).re • A13 := by
    obtain ⟨r10, i10⟩ := o 0 1
    obtain ⟨r21, i21⟩ := o 1 2
    obtain ⟨r20, i20⟩ := o 0 2
    have d0 := d 0
    have d1 := d 1
    have d2 := d 2
    ext i j
    fin_cases i <;> fin_cases j <;> apply Complex.ext <;>
      simp [X, Y12, Y23, A12, A23, A13, S13, H1] <;> linarith
  rw [key]
  refine L.add_mem (L.add_mem (L.add_mem (L.add_mem (L.add_mem (L.add_mem (L.add_mem
    (L.smul_mem _ H1_mem) (L.smul_mem _ X_mem)) (L.smul_mem _ Y12_mem)) (L.smul_mem _ A12_mem))
    (L.smul_mem _ Y23_mem)) (L.smul_mem _ A23_mem)) (L.smul_mem _ S13_mem)) (L.smul_mem _ A13_mem)

theorem X_mem_su3 : X ∈ su3 := by
  refine ⟨?_, ?_⟩
  · ext i j; fin_cases i <;> fin_cases j <;> simp [X, conjTranspose_apply]
  · simp [X, Matrix.trace, Fin.sum_univ_three]; ring

theorem Y_mem_su3 : Y ∈ su3 := by
  refine ⟨?_, ?_⟩
  · ext i j; fin_cases i <;> fin_cases j <;> simp [Y, conjTranspose_apply]
  · simp [Y, Matrix.trace, Fin.sum_univ_three]

/-- **`Lie(X, Y) = su(3)`.** -/
theorem lieSpan_XY_eq_su3 : L = su3 := by
  apply le_antisymm
  · rw [LieSubalgebra.lieSpan_le]
    intro Z hZ
    rcases hZ with rfl | rfl
    · exact X_mem_su3
    · exact Y_mem_su3
  · intro A hA
    exact mem_lieSpan_of_su3 A hA.1 hA.2

end GppSU3Holonomy

#print axioms GppSU3Holonomy.lieSpan_XY_eq_su3
#print axioms GppSU3Holonomy.adX_sq_Y
