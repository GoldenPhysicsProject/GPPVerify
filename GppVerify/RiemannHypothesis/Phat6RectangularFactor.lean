/-- **The explicit factorisation** `P̂₆ = Cᵀ C`. -/
theorem phat6_eq : Phat6 = C24ᵀ * C24 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Phat6, C24, Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply] <;> norm_num

/-- **Rectangular Gram factor over `ℚ`.** -/
theorem phat6_rectangular_factor : ∃ C : Matrix (Fin 24) (Fin 6) ℚ, Phat6 = Cᵀ * C :=
  ⟨C24, phat6_eq⟩

/-- **`P̂₆` is positive semidefinite as a quadratic form**: `xᵀ P̂₆ x = ‖C x‖² ≥ 0`. -/
theorem phat6_quadratic_nonneg (x : Fin 6 → ℚ) : 0 ≤ x ⬝ᵥ (Phat6 *ᵥ x) := by
  rw [phat6_eq, ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, Matrix.vecMul_transpose]
  exact Finset.sum_nonneg fun i _ => mul_self_nonneg _

end GppPhat6
