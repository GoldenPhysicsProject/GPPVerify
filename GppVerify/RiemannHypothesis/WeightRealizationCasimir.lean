import Mathlib.Analysis.Calculus.Deriv.Mul
import Mathlib.Analysis.Calculus.Deriv.Add
import Mathlib.Analysis.Calculus.Deriv.Pow
import Mathlib.Analysis.Calculus.Deriv.Star
import Mathlib.Analysis.SpecialFunctions.Complex.Analytic
import Mathlib.MeasureTheory.Integral.IntegralEqImproper
import Mathlib.Tactic

/-!
# The weight-`Δ` realization of `sl(2,ℝ)`: Casimir `Δ(Δ−1)` and unitarity iff `Re Δ = 1/2`

Statements requested by Daniel Toupin / Golden Physics Project (2026-11-06): prove that the Mellin
variable `s` *is* the conformal weight `Δ` of a principal-series sector, without any zero-location
claim. Formalization: Claude Code.

On functions `f : ℝ → ℂ` the weight-`Δ` realization of `sl(2,ℝ)` is generated by

* `P f = f'`,
* `D f = x f' + Δ f`,
* `K f = x² f' + 2 Δ x f`.

* `casimir_weight`: for every twice-differentiable `f`, the Casimir
  `D² − ½(PK + KP)` acts as the scalar `Δ(Δ − 1)`. So `Δ` *is* the weight of the representation,
  independently of `f`.
* `antiHermitian_defect_pointwise` / `antiHermitian_defect_integral`: for
  `⟨f, g⟩ = ∫ conj f · g`, the defect `⟨D f, g⟩ + ⟨f, D g⟩` equals
  `(2 Re Δ − 1) ⟨f, g⟩` plus an exact derivative that integrates to `0`.
* `antiHermitian_iff`: on a test function with `⟨f, f⟩ ≠ 0`, `D` is anti-Hermitian (so it
  generates a unitary dilation) if and only if `Re Δ = 1/2`, i.e. exactly on the principal series.

**Scope.** The generator-level statements for this concrete realization. The group action, the full
unitary-representation statement, irreducibility, the 4D massless one-particle space and its
decomposition into principal series (Mellin–Plancherel), and the identification of this `Δ` with
the arithmetic `s` beyond the Mellin character of `OneDimensionalMellinWeight` are NOT formalized.
**Nothing here says where any particular complex number lies**: whether a given `Δ` (for instance
a zero of the completed zeta function) belongs to the unitary sector is the same question as
whether `Re Δ = 1/2` for it. No claim about RH.
-/

set_option autoImplicit false

namespace GppWeightRealizationCasimir

open MeasureTheory

/-- Translation generator `P f = f'`. -/
noncomputable def Pop (f : ℝ → ℂ) : ℝ → ℂ := deriv f

/-- Dilation generator `D f = x f' + Δ f`. -/
noncomputable def Dop (Δ : ℂ) (f : ℝ → ℂ) : ℝ → ℂ := fun x => (x : ℂ) * deriv f x + Δ * f x

/-- Special-conformal generator `K f = x² f' + 2 Δ x f`. -/
noncomputable def Kop (Δ : ℂ) (f : ℝ → ℂ) : ℝ → ℂ :=
  fun x => (x : ℂ) ^ 2 * deriv f x + 2 * Δ * (x : ℂ) * f x

/-- **The Casimir is the scalar `Δ(Δ − 1)`.** -/
theorem casimir_weight (Δ : ℂ) {f : ℝ → ℂ} (hf : Differentiable ℝ f)
    (hf' : Differentiable ℝ (deriv f)) (x : ℝ) :
    Dop Δ (Dop Δ f) x - (1 / 2 : ℂ) * (Pop (Kop Δ f) x + Kop Δ (Pop f) x)
      = Δ * (Δ - 1) * f x := by
  have h0 : HasDerivAt f (deriv f x) x := (hf x).hasDerivAt
  have h1 : HasDerivAt (deriv f) (deriv (deriv f) x) x := (hf' x).hasDerivAt
  have hX : HasDerivAt (fun y : ℝ => (y : ℂ)) 1 x := (hasDerivAt_id x).ofReal_comp
  have hD : HasDerivAt (Dop Δ f)
      (1 * deriv f x + (x : ℂ) * deriv (deriv f) x + Δ * deriv f x) x :=
    (hX.mul h1).add (h0.const_mul Δ)
  have hK : HasDerivAt (Kop Δ f)
      (2 * (x : ℂ) * deriv f x + (x : ℂ) ^ 2 * deriv (deriv f) x
        + (2 * Δ * f x + 2 * Δ * (x : ℂ) * deriv f x)) x := by
    have h := ((hX.pow 2).mul h1).add ((hX.const_mul (2 * Δ)).mul h0)
    exact h.congr_deriv (by push_cast; simp only [Pi.pow_apply]; ring)
  unfold Pop
  rw [hK.deriv]
  simp only [Dop, Kop, hD.deriv]
  ring

/-- `Δ + conj Δ = 2 Re Δ`. -/
theorem star_add_self (Δ : ℂ) : star Δ + Δ = 2 * (Δ.re : ℂ) := by
  apply Complex.ext
  · simp
    ring
  · simp

/-- **Pointwise unitarity defect.** `conj(D f)·g + conj f·(D g)` is the derivative of
`x · conj f · g` plus `(2 Re Δ − 1)` times `conj f · g`. -/
theorem antiHermitian_defect_pointwise (Δ : ℂ) (f g : ℝ → ℂ) (x : ℝ) :
    star (Dop Δ f x) * g x + star (f x) * Dop Δ g x
      = (star (f x) * g x
          + (x : ℂ) * (star (deriv f x) * g x + star (f x) * deriv g x))
        + (2 * (Δ.re : ℂ) - 1) * (star (f x) * g x) := by
  have hΔ := star_add_self Δ
  have hxs : star (x : ℂ) = (x : ℂ) := Complex.conj_ofReal x
  unfold Dop
  simp only [star_add, star_mul, hxs]
  linear_combination (star (f x) * g x) * hΔ

/-- The exact antiderivative: `h(y) = y · conj f(y) · g(y)` has derivative the middle expression
of `antiHermitian_defect_pointwise`. -/
theorem hasDerivAt_boundary {f g : ℝ → ℂ}
    (hf : Differentiable ℝ f) (hg : Differentiable ℝ g) (x : ℝ) :
    HasDerivAt (fun y : ℝ => (y : ℂ) * (star (f y) * g y))
      (star (f x) * g x
        + (x : ℂ) * (star (deriv f x) * g x + star (f x) * deriv g x)) x := by
  have hX : HasDerivAt (fun y : ℝ => (y : ℂ)) 1 x := (hasDerivAt_id x).ofReal_comp
  have h0 : HasDerivAt f (deriv f x) x := (hf x).hasDerivAt
  have h0g : HasDerivAt g (deriv g x) x := (hg x).hasDerivAt
  have hs : HasDerivAt (fun y : ℝ => star (f y)) (star (deriv f x)) x := h0.star
  exact ((hX.mul (hs.mul h0g))).congr_deriv (by simp only [Pi.mul_apply]; ring)

/-- **Integrated unitarity defect.** If the boundary term and the relevant integrands are
integrable, `⟨D f, g⟩ + ⟨f, D g⟩ = (2 Re Δ − 1)·⟨f, g⟩`. -/
theorem antiHermitian_defect_integral (Δ : ℂ) {f g : ℝ → ℂ}
    (hf : Differentiable ℝ f) (hg : Differentiable ℝ g)
    (hb : Integrable (fun y : ℝ => (y : ℂ) * (star (f y) * g y)))
    (hb' : Integrable (fun x : ℝ => star (f x) * g x
        + (x : ℂ) * (star (deriv f x) * g x + star (f x) * deriv g x)))
    (hfg : Integrable (fun x : ℝ => star (f x) * g x)) :
    ∫ x, (star (Dop Δ f x) * g x + star (f x) * Dop Δ g x)
      = (2 * (Δ.re : ℂ) - 1) * ∫ x, star (f x) * g x := by
  have hz : ∫ x, (star (f x) * g x
      + (x : ℂ) * (star (deriv f x) * g x + star (f x) * deriv g x)) = 0 :=
    integral_eq_zero_of_hasDerivAt_of_integrable (fun x => hasDerivAt_boundary hf hg x) hb' hb
  have hpt : (fun x => star (Dop Δ f x) * g x + star (f x) * Dop Δ g x)
      = fun x => (star (f x) * g x
          + (x : ℂ) * (star (deriv f x) * g x + star (f x) * deriv g x))
        + (2 * (Δ.re : ℂ) - 1) * (star (f x) * g x) := by
    funext x; exact antiHermitian_defect_pointwise Δ f g x
  rw [hpt, integral_add hb' (hfg.const_mul _), hz, integral_const_mul]
  ring

/-- **`D` is anti-Hermitian on a test function iff `Re Δ = 1/2`.** -/
theorem antiHermitian_iff (Δ : ℂ) {f : ℝ → ℂ} (hf : Differentiable ℝ f)
    (hb : Integrable (fun y : ℝ => (y : ℂ) * (star (f y) * f y)))
    (hb' : Integrable (fun x : ℝ => star (f x) * f x
        + (x : ℂ) * (star (deriv f x) * f x + star (f x) * deriv f x)))
    (hff : Integrable (fun x : ℝ => star (f x) * f x))
    (hne : ∫ x, star (f x) * f x ≠ 0) :
    ∫ x, (star (Dop Δ f x) * f x + star (f x) * Dop Δ f x) = 0 ↔ Δ.re = 1 / 2 := by
  rw [antiHermitian_defect_integral Δ hf hf hb hb' hff]
  constructor
  · intro h
    rcases mul_eq_zero.mp h with h | h
    · have := congrArg Complex.re h
      simp at this
      linarith
    · exact absurd h hne
  · intro h
    have : (2 * (Δ.re : ℂ) - 1) = 0 := by
      rw [h]; push_cast; ring
    rw [this, zero_mul]

end GppWeightRealizationCasimir
