/-- Piece `i`'s coefficient list. -/
def pieceQ (i : ℕ) : List ℚ := pieceTable.getD i []

/-- `∫_{i/4}^{(i+1)/4} p_i(r) r^s dr`, exactly (`e = s + k + 1`). -/
def pieceMom (i s : ℕ) : ℚ :=
  ((List.range (pieceQ i).length).map fun k =>
    (pieceQ i).getD k 0 * (((((i + 1) ^ (s + k + 1) - i ^ (s + k + 1) : ℕ) : ℚ)) /
      ((4 ^ (s + k + 1) * (s + k + 1) : ℕ) : ℚ))).sum

/-- `∫_{-25}^{25} m(r) r^s dr` by the piecewise formula. -/
def momFormula (s : ℕ) : ℚ :=
  if s % 2 = 0 then 2 * ((List.range 100).map fun i => pieceMom i s).sum else 0

/-- The table agrees with the formula. -/
def momOK : Bool := (List.range 96).all fun s => momTable.getD s 0 == momFormula s

set_option maxRecDepth 200000 in
theorem momOK_eq : momOK = true := by decide +kernel

/-! ### The minorant as a function -/

/-- On `(i/4, (i+1)/4]`, `i = ⌈4r⌉₊ - 1`. -/
noncomputable def mpos (r : ℝ) : ℝ := evalR (pieceQ (⌈4 * r⌉₊ - 1)) r

/-- The even minorant. -/
noncomputable def mfun (r : ℝ) : ℝ := mpos |r|

theorem mpos_eq_on_piece (i : ℕ) {r : ℝ} (hr : r ∈ Set.uIoc ((i : ℝ) / 4) (((i : ℝ) + 1) / 4)) :
    mpos r = evalR (pieceQ i) r := by
  rw [Set.uIoc_of_le (by linarith)] at hr
  have hc : ⌈4 * r⌉₊ = i + 1 := by
    rw [Nat.ceil_eq_iff (by omega)]
    push_cast
    constructor <;> [linarith [hr.1]; linarith [hr.2]]
  unfold mpos; rw [hc, Nat.add_sub_cancel]

theorem integral_piece (i s : ℕ) :
    ∫ r in ((i : ℝ) / 4)..(((i : ℝ) + 1) / 4), mpos r * r ^ s = ((pieceMom i s : ℚ) : ℝ) := by
  have hcongr : ∫ r in ((i : ℝ) / 4)..(((i : ℝ) + 1) / 4), mpos r * r ^ s =
      ∫ r in ((i : ℝ) / 4)..(((i : ℝ) + 1) / 4), evalR (pieceQ i) r * r ^ s := by
    refine intervalIntegral.integral_congr_ae (Filter.Eventually.of_forall fun r hr => ?_)
    rw [mpos_eq_on_piece i hr]
  rw [hcongr]
  unfold evalR pieceMom
  rw [← sum_range_eq_list, Rat.cast_sum]
  simp_rw [sum_mul]
  rw [intervalIntegral.integral_finsetSum]
  · refine sum_congr rfl fun k _ => ?_
    have e : (fun r : ℝ => ((pieceQ i).getD k 0 : ℝ) * r ^ k * r ^ s) =
        fun r => ((pieceQ i).getD k 0 : ℝ) * r ^ (s + k) := by
      funext r; rw [pow_add]; ring
    rw [e, intervalIntegral.integral_const_mul, integral_pow]
    have hle : i ^ (s + k + 1) ≤ (i + 1) ^ (s + k + 1) := Nat.pow_le_pow_left (by omega) _
    have hdiff : (((i : ℝ) + 1) / 4) ^ (s + k + 1) - ((i : ℝ) / 4) ^ (s + k + 1) =
        (((i + 1) ^ (s + k + 1) - i ^ (s + k + 1) : ℕ) : ℝ) / (4 : ℝ) ^ (s + k + 1) := by
      rw [Nat.cast_sub hle, div_pow, div_pow]; push_cast; ring
    rw [hdiff]
    simp only [Rat.cast_mul, Rat.cast_div, Rat.cast_natCast]
    push_cast
    field_simp
  · intro k _
    exact (by fun_prop : Continuous fun r : ℝ =>
      ((pieceQ i).getD k 0 : ℝ) * r ^ k * r ^ s).intervalIntegrable _ _

theorem intervalIntegrable_piece (i : ℕ) (g : ℝ → ℝ) (hg : Continuous g) :
    IntervalIntegrable (fun r => mpos r * g r) volume ((i : ℝ) / 4) (((i : ℝ) + 1) / 4) := by
  have h0 : IntervalIntegrable (fun r => evalR (pieceQ i) r * g r) volume ((i : ℝ) / 4)
      (((i : ℝ) + 1) / 4) := ((continuous_evalR (pieceQ i)).mul hg).intervalIntegrable _ _
  refine h0.congr fun r hr => ?_
  show evalR (pieceQ i) r * g r = mpos r * g r
  rw [mpos_eq_on_piece i hr]

theorem intervalIntegrable_mpos_mul (g : ℝ → ℝ) (hg : Continuous g) :
    IntervalIntegrable (fun r => mpos r * g r) volume 0 25 := by
  have h := IntervalIntegrable.trans_iterate (a := fun k : ℕ => (k : ℝ) / 4) (n := 100)
    (fun k _ => by
      have := intervalIntegrable_piece k g hg
      simpa [add_div] using this)
  convert h using 1 <;> norm_num

theorem integral_mpos_mul_pow (s : ℕ) :
    ∫ r in (0 : ℝ)..25, mpos r * r ^ s = ∑ i ∈ range 100, ((pieceMom i s : ℚ) : ℝ) := by
  have h := intervalIntegral.sum_integral_adjacent_intervals (a := fun k : ℕ => (k : ℝ) / 4)
    (n := 100) (f := fun r => mpos r * r ^ s) (μ := volume)
    (fun k _ => by
      have := intervalIntegrable_piece k (fun r => r ^ s) (continuous_pow s)
      simpa [add_div] using this)
  simp only [Nat.cast_ofNat] at h
  norm_num at h
  rw [← h]
  refine sum_congr rfl fun i _ => ?_
  have := integral_piece i s
  simpa [add_div] using this

theorem mfun_eq_mpos {r : ℝ} (hr : 0 ≤ r) : mfun r = mpos r := by
  unfold mfun; rw [abs_of_nonneg hr]

theorem mfun_neg (r : ℝ) : mfun (-r) = mfun r := by unfold mfun; rw [abs_neg]

theorem intervalIntegrable_mfun_pos : IntervalIntegrable mfun volume 0 25 := by
  refine (intervalIntegrable_mpos_mul (fun _ => 1) continuous_const).congr fun r hr => ?_
  rw [Set.uIoc_of_le (by norm_num)] at hr
  simp only [mul_one]; rw [mfun_eq_mpos hr.1.le]

/-- The minorant is integrable on `[-25, 25]`. -/
theorem intervalIntegrable_mfun : IntervalIntegrable mfun volume (-25) 25 := by
  have hN : IntervalIntegrable mfun volume (-25) 0 := by
    have h := (IntervalIntegrable.iff_comp_neg (f := mfun)).mp intervalIntegrable_mfun_pos
    simp only [neg_zero, mfun_neg] at h
    exact h.symm
  exact hN.trans intervalIntegrable_mfun_pos

/-- **The moments of the minorant, by the piecewise formula.** -/
theorem integral_mfun_mul_pow_eq (s : ℕ) :
    ∫ r in (-25 : ℝ)..25, mfun r * r ^ s = ((momFormula s : ℚ) : ℝ) := by
  have hint : ∀ a b : ℝ, a ∈ Set.uIcc (-25 : ℝ) 25 → b ∈ Set.uIcc (-25 : ℝ) 25 →
      IntervalIntegrable (fun r => mfun r * r ^ s) volume a b := by
    intro a b ha hb
    exact (intervalIntegrable_mfun.mono_set (Set.uIcc_subset_uIcc ha hb)).mul_continuousOn
      (continuous_pow s).continuousOn
  have hpos : ∫ r in (0 : ℝ)..25, mfun r * r ^ s = ∫ r in (0 : ℝ)..25, mpos r * r ^ s := by
    refine intervalIntegral.integral_congr_ae (Filter.Eventually.of_forall fun r hr => ?_)
    rw [Set.uIoc_of_le (by norm_num)] at hr
    rw [mfun_eq_mpos hr.1.le]
  have hneg : ∫ r in (-25 : ℝ)..0, mfun r * r ^ s =
      (-1) ^ s * ∫ r in (0 : ℝ)..25, mfun r * r ^ s := by
    have := intervalIntegral.integral_comp_neg (a := (0 : ℝ)) (b := 25)
      (fun r => mfun r * r ^ s)
    simp only [neg_zero] at this
    rw [← this, ← intervalIntegral.integral_const_mul]
    congr 1; funext r; rw [mfun_neg, neg_pow]; ring
  have hm25 : (-25 : ℝ) ∈ Set.uIcc (-25 : ℝ) 25 := Set.left_mem_uIcc
  have h25 : (25 : ℝ) ∈ Set.uIcc (-25 : ℝ) 25 := Set.right_mem_uIcc
  have h0 : (0 : ℝ) ∈ Set.uIcc (-25 : ℝ) 25 := by
    rw [Set.uIcc_of_le (by norm_num)]; constructor <;> norm_num
  rw [← intervalIntegral.integral_add_adjacent_intervals
    (hint (-25) 0 hm25 h0) (hint 0 25 h0 h25), hneg, hpos,
    integral_mpos_mul_pow]
  unfold momFormula
  rw [← sum_range_eq_list]
  split_ifs with h
  · obtain ⟨k, hk⟩ := Nat.even_iff.mpr h
    rw [hk, ← two_mul, pow_mul]; push_cast; ring
  · have hodd : Odd s := Nat.odd_iff.mpr (by omega)
    rw [hodd.neg_one_pow]; push_cast; ring

/-- **The moment table is right.** For `s < 96`, `∫_{-25}^{25} m(r) r^s dr = momTable[s]`. -/
theorem integral_mfun_mul_pow {s : ℕ} (hs : s < 96) :
    ∫ r in (-25 : ℝ)..25, mfun r * r ^ s = ((momTable.getD s 0 : ℚ) : ℝ) := by
  have h := momOK_eq
  unfold momOK at h
  rw [List.all_eq_true] at h
