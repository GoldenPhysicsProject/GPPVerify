def dDev (j : ℕ) : ℕ := dDevList.getD j 0

/-- Upper-triangle entry `s_{i,k}` (`i < k`): the 32-bit slot `k − i − 1` of `pRow i`. -/
def sEnt (i k : ℕ) : ℕ := (pRow i / 2 ^ (32 * (k - i - 1))) % 2 ^ 32

/-- The symmetric bound matrix, zero on the diagonal. -/
def sSym (j k : ℕ) : ℕ := if j < k then sEnt j k else if k < j then sEnt k j else 0

theorem sSym_comm (j k : ℕ) : sSym j k = sSym k j := by
  unfold sSym
  by_cases h : j < k
  · simp [h, not_lt.mpr h.le]
  · by_cases h' : k < j
    · simp [h, h']
    · have : j = k := by omega
      subst this; rfl

theorem sSym_self (j : ℕ) : sSym j j = 0 := by simp [sSym]

