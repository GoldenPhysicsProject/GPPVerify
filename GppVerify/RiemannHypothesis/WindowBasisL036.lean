/-- The `k`-th basis polynomial's coefficient list. -/
def phiQ (k : ℕ) : List ℚ := phiTable.getD k []

/-- The spanning coefficients. -/
def alphaQ (k j : ℕ) : ℚ := (alphaTable.getD k []).getD j 0

/-- Orthogonality with the Legendre norms, as a Boolean check. -/
def orthoOK : Bool :=
  (List.range 32).all fun j => (List.range 32).all fun k =>
    ipQ ellQ (phiQ j) (phiQ k) == if j = k then 2 * ellQ / (2 * (k : ℚ) + 1) else 0

/-- Spanning, as a Boolean check. -/
def spanOK : Bool :=
  (List.range 32).all fun k => (List.range 32).all fun i =>
    (if i = k then (1 : ℚ) else 0) == ((List.range 32).map fun j => alphaQ k j * (phiQ j).getD i 0).sum

/-- Lengths. -/
def lenOK : Bool := (List.range 32).all fun k => decide ((phiQ k).length ≤ 32)

set_option maxRecDepth 200000 in
theorem orthoOK_eq : orthoOK = true := by decide +kernel

set_option maxRecDepth 200000 in
theorem spanOK_eq : spanOK = true := by decide +kernel

theorem lenOK_eq : lenOK = true := by decide +kernel

/-! ### Real-side corollaries -/

/-- The basis as real functions. -/
noncomputable def phi (k : Fin 32) : ℝ → ℝ := evalR (phiQ k)

theorem continuous_phi (k : Fin 32) : Continuous (phi k) := continuous_evalR _

theorem orth_rat (j k : Fin 32) :
    ipQ ellQ (phiQ j) (phiQ k) = if (j : ℕ) = k then 2 * ellQ / (2 * ((k : ℕ) : ℚ) + 1) else 0 := by
  have h := orthoOK_eq
  unfold orthoOK at h
  rw [List.all_eq_true] at h
  have hj := h j (List.mem_range.mpr j.isLt)
  rw [List.all_eq_true] at hj
  have hk := hj k (List.mem_range.mpr k.isLt)
  exact beq_iff_eq.mp hk

theorem phi_orth (j k : Fin 32) (hjk : j ≠ k) : ip ((ellQ : ℚ) : ℝ) (phi j) (phi k) = 0 := by
  unfold phi
  rw [ip_evalR, orth_rat, if_neg (fun h => hjk (Fin.ext h))]; simp

theorem phi_d (k : Fin 32) :
    ip ((ellQ : ℚ) : ℝ) (phi k) (phi k) = ((2 * ellQ / (2 * ((k : ℕ) : ℚ) + 1) : ℚ) : ℝ) := by
  unfold phi
  rw [ip_evalR, orth_rat, if_pos rfl]

theorem phi_d_pos (k : Fin 32) : 0 < ip ((ellQ : ℚ) : ℝ) (phi k) (phi k) := by
  rw [phi_d]
  have : (0 : ℚ) < 2 * ellQ / (2 * ((k : ℕ) : ℚ) + 1) := by unfold ellQ; positivity
  exact_mod_cast this

/-- The monomial `x^k` as a coefficient list. -/
def monoList (k : ℕ) : List ℚ := List.replicate k 0 ++ [1]

theorem monoList_length (k : ℕ) : (monoList k).length = k + 1 := by simp [monoList]

theorem monoList_getD (k i : ℕ) : (monoList k).getD i 0 = if i = k then 1 else 0 := by
  unfold monoList
  rcases lt_trichotomy i k with h | h | h
  · rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_append_left (by simp; omega)]
    simp [h.ne]
  · subst h
    rw [List.getD_eq_getElem _ _ (by simp)]
    simp
  · rw [List.getD_eq_default _ _ (by simp; omega)]
    simp [h.ne']

theorem evalR_monoList (k : ℕ) (x : ℝ) : evalR (monoList k) x = x ^ k := by
  unfold evalR
  rw [monoList_length]
  simp_rw [monoList_getD]
  rw [sum_eq_single k (fun i _ hik => by simp [hik]) (by simp)]
  simp

theorem span_rat (k i : ℕ) (hk : k < 32) (hi : i < 32) :
    (monoList k).getD i 0 = ∑ j : Fin 32, alphaQ k j * (phiQ j).getD i 0 := by
  have h := spanOK_eq
  unfold spanOK at h
  rw [List.all_eq_true] at h
  have hk' := h k (List.mem_range.mpr hk)
  rw [List.all_eq_true] at hk'
  have hi' := beq_iff_eq.mp (hk' i (List.mem_range.mpr hi))
  rw [monoList_getD, hi', ← sum_range_eq_list, Fin.sum_univ_eq_sum_range
    (fun j => alphaQ k j * (phiQ j).getD i 0)]

theorem phi_span (k : ℕ) (hk : k < 32) :
    ∃ α : Fin 32 → ℝ, ∀ x, x ^ k = ∑ j, α j * phi j x := by
  refine ⟨fun j => (alphaQ k j : ℝ), fun x => ?_⟩
  have hlen : ∀ j : Fin 32, (phiQ j).length ≤ 32 := by
    intro j
    have h := lenOK_eq
    unfold lenOK at h
    rw [List.all_eq_true] at h
    exact of_decide_eq_true (h j (List.mem_range.mpr j.isLt))
  rw [← evalR_monoList]
  exact evalR_eq_of_coeff (K := 32) (monoList k) (fun j => phiQ j) (fun j => alphaQ k j)
    (by rw [monoList_length]; omega) hlen (fun i hi => span_rat k i hk hi) x

