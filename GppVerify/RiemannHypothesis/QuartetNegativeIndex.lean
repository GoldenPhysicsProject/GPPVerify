import GppVerify.RiemannHypothesis.HolographicReflectionPositivity
import Mathlib.Tactic

/-!
# An off-line zero quartet costs two negative directions; one time direction forbids it

Builds on `GppHolographicRP` (a mirror pair spans a hyperbolic plane). Daniel Toupin's picture of four
points `ρ, 1 - ρ, ρ̄, 1 - ρ̄` is the orbit of the Klein four-group generated by the shadow reflection
`τ(s) = 1 - s̄` and complex conjugation `c(s) = s̄`. For a zero off the critical line the orbit is two
distinct mirror pairs `{ρ, τρ}` and `{cρ, τcρ}`, because `c` never preserves a mirror pair of a non-real
off-line point.

## What is proved (finite core, abstract `τ`, `c`)

* `quartet_negative_family`: if `τ z ≠ z`, `c z ∉ {z, τ z}`, `τ`, `c` are commuting involutions and the
  multiplicities are positive, there are two vectors on whose whole span the reflection form is strictly
  negative: the form has negative index at least `2`.
* `offline_conditions`: for `ρ ∈ ℂ` with `Re ρ ≠ 1/2` and `Im ρ ≠ 0`, `τ ρ ≠ ρ` and `c ρ ∉ {ρ, τ ρ}`.
* `negativeIndex_le_one_forces_line`: **if the reflection form has no two-dimensional negative-definite
  subspace** ("one time direction": negative index at most `1`), then every sampled zero lies on the
  critical line, given that the sample is closed under `τ` and `c` and contains no real points.

Since a single mirror pair has negative index `1`, an odd count is possible in the abstract model, but
conjugation pairs the mirror pairs, so the count of mirror pairs is always even. Hence "index at most 1"
is as strong as "index `0`" there: a single time direction is incompatible with any off-line zero.

## Scope

Finite algebra. Passing from this to the actual Weil form requires (a) the explicit formula and (b) that the
sample values `F(ρ)` of test functions can be prescribed independently at the zeros (the same unproved
hypothesis already named in `HolographicReflectionPositivity`). Under those hypotheses this says
"the Weil form has at most one negative direction" is **equivalent** to RH, so it reformulates RH as a
Lorentzian-signature statement; it does not prove RH, and nothing here assumes it. The continuum model
`exp(|x-y|/2)` does have at most one positive direction (`GppContinuumInertia.no_two_dim_positive`),
which is consistent with, but does not imply, that hypothesis for the actual prime sum.
-/

open Finset ComplexConjugate GppHolographicRP

namespace GppQuartetIndex

variable {Z : Type*} [Fintype Z] [DecidableEq Z]

/-- Vector supported on a mirror pair with values `(1, -1)`. -/
def pairVec (τ : Z → Z) (z : Z) : Z → ℂ := fun w => if w = z then 1 else if w = τ z then -1 else 0

/-- Two vectors on whose entire span the real part of the reflection form is strictly negative. -/
def NegativeFamily2 (τ : Z → Z) (m : Z → ℝ) : Prop :=
  ∃ u₁ u₂ : Z → ℂ, ∀ a b : ℂ, (a ≠ 0 ∨ b ≠ 0) →
    (reflectionForm τ m (fun w => a * u₁ w + b * u₂ w)).re < 0

/-- **A quartet spans a negative-definite plane.** -/
theorem quartet_negative_family (τ c : Z → Z) (hτ : ∀ z, τ (τ z) = z) (hc : ∀ z, c (c z) = z)
    (hcomm : ∀ z, τ (c z) = c (τ z)) (m : Z → ℝ) (hm0 : ∀ z, 0 < m z)
    (z : Z) (hz : τ z ≠ z) (hcz : c z ≠ z) (hcτ : c z ≠ τ z) :
    NegativeFamily2 τ m := by
  classical
  -- the four points are distinct
  have h1 : z ≠ τ z := fun h => hz h.symm
  have h2 : c z ≠ τ z := hcτ
  have h3 : τ (c z) ≠ c z := by
    intro h
    apply hz
    have := hcomm z
    rw [h] at this
    have h' : c z = c (τ z) := this
    have := congrArg c h'
    rw [hc, hc] at this
    exact this.symm
  have h4 : c z ≠ z := hcz
  have h5 : τ (c z) ≠ z := by
    intro h
    apply hcτ
    have := congrArg τ h
    rwa [hτ] at this
  have h6 : τ (c z) ≠ τ z := by
    intro h
    apply hcz
    have := congrArg τ h
    rwa [hτ, hτ] at this
  refine ⟨pairVec τ z, pairVec τ (c z), fun a b hab => ?_⟩
  -- evaluate the form on the four-point support
  have hsupp : ∀ w, w ∉ ({z, τ z, c z, τ (c z)} : Finset Z) →
      (fun w => a * pairVec τ z w + b * pairVec τ (c z) w) w = 0 := by
    intro w hw
    simp only [mem_insert, mem_singleton, not_or] at hw
    obtain ⟨hw1, hw2, hw3, hw4⟩ := hw
    simp [pairVec, hw1, hw2, hw3, hw4]
  have hform : reflectionForm τ m (fun w => a * pairVec τ z w + b * pairVec τ (c z) w) =
      ∑ w ∈ ({z, τ z, c z, τ (c z)} : Finset Z), (m w : ℂ) *
        ((fun w => a * pairVec τ z w + b * pairVec τ (c z) w) w *
          conj ((fun w => a * pairVec τ z w + b * pairVec τ (c z) w) (τ w))) := by
    unfold reflectionForm
    refine (sum_subset (subset_univ _) (fun w _ hw => ?_)).symm
    rw [hsupp w hw]; simp
  rw [hform]
  have e1 : z ≠ τ (c z) := fun h => h5 h.symm
  have e2 : τ z ≠ c z := fun h => h2 h.symm
  have e3 : τ z ≠ τ (c z) := fun h => h6 h.symm
  have e4 : z ≠ c z := fun h => h4 h.symm
  have e5 : c z ≠ τ (c z) := fun h => h3 h.symm
  rw [sum_insert (by simp [h1, e4, e1]), sum_insert (by simp [e2, e3]),
    sum_insert (by simp [e5]), sum_singleton]
  simp [pairVec, hτ, h2, h3, h4, h5, h6, e1, e2, e3, e4, hz,
    Complex.mul_conj, Complex.normSq_eq_norm_sq]
  simp only [← Complex.ofReal_pow, Complex.ofReal_re]
  have hb2 : 0 ≤ ‖b‖ ^ 2 := sq_nonneg _
  have ha2 : 0 ≤ ‖a‖ ^ 2 := sq_nonneg _
  have m1 := hm0 z
  have m2 := hm0 (τ z)
  have m3 := hm0 (c z)
  have m4 := hm0 (τ (c z))
  rcases hab with ha | hb
  · have : 0 < ‖a‖ ^ 2 := by positivity
    nlinarith [mul_pos m1 this, mul_nonneg m2.le ha2, mul_nonneg m3.le hb2, mul_nonneg m4.le hb2]
  · have : 0 < ‖b‖ ^ 2 := by positivity
    nlinarith [mul_pos m3 this, mul_nonneg m1.le ha2, mul_nonneg m2.le ha2, mul_nonneg m4.le hb2]

/-- Complex numbers: for `ρ` off the critical line and non-real, the shadow reflection `τ s = 1 - s̄`
and conjugation `c s = s̄` satisfy the hypotheses of `quartet_negative_family`. -/
theorem offline_conditions (ρ : ℂ) (hre : ρ.re ≠ 1 / 2) (him : ρ.im ≠ 0) :
    (1 - conj ρ ≠ ρ) ∧ (conj ρ ≠ ρ) ∧ (conj ρ ≠ 1 - conj ρ) := by
  refine ⟨?_, ?_, ?_⟩
  · intro h
    apply hre
    have := congrArg Complex.re h
    simp at this
    linarith
  · intro h
    apply him
    have := congrArg Complex.im h
    simp at this
    linarith
  · intro h
    apply him
    have := congrArg Complex.re h
    have h2 := congrArg Complex.im h
    simp at this h2
    linarith

/-- **One time direction forces the critical line.** Let `ι : Z → ℂ` place a finite sample of points
(zeros) in the plane, closed under the shadow reflection `τ` and conjugation `c`
(`ι (τ z) = 1 - conj (ι z)`, `ι (c z) = conj (ι z)`), with positive multiplicities and no real points.
If the reflection form has **no two-dimensional negative-definite subspace** (negative index at most
`1`), then every sampled point lies on the critical line. -/
theorem negativeIndex_le_one_forces_line (ι : Z → ℂ) (τ c : Z → Z)
    (hτ : ∀ z, τ (τ z) = z) (hc : ∀ z, c (c z) = z) (hcomm : ∀ z, τ (c z) = c (τ z))
    (hτι : ∀ z, ι (τ z) = 1 - conj (ι z)) (hcι : ∀ z, ι (c z) = conj (ι z))
    (hnonreal : ∀ z, (ι z).im ≠ 0) (m : Z → ℝ) (hm0 : ∀ z, 0 < m z)
    (hindex : ¬ NegativeFamily2 τ m) : ∀ z, (ι z).re = 1 / 2 := by
  intro z
  by_contra hre
  obtain ⟨h1, h2, h3⟩ := offline_conditions (ι z) hre (hnonreal z)
  apply hindex
  refine quartet_negative_family τ c hτ hc hcomm m hm0 z ?_ ?_ ?_
  · intro h
    apply h1
    rw [← hτι, h]
  · intro h
    apply h2
    rw [← hcι, h]
  · intro h
    apply h3
    have := congrArg ι h
    rw [hcι, hτι] at this
    exact this

omit [DecidableEq Z] in
/-- Converse direction (sanity check): if the sample is on the line there is no mirror pair, so the
form is nonnegative and in particular has no negative-definite subspace of any dimension. -/
theorem online_form_nonneg (ι : Z → ℂ) (τ : Z → Z)
    (hτι : ∀ z, ι (τ z) = 1 - conj (ι z)) (hline : ∀ z, (ι z).re = 1 / 2)
    (hι : Function.Injective ι) (m : Z → ℝ) (hm0 : ∀ z, 0 ≤ m z) (v : Z → ℂ) :
    0 ≤ (reflectionForm τ m v).re := by
  have hfix : ∀ z, τ z = z := by
    intro z
    apply hι
    rw [hτι]
    apply Complex.ext
    · simp [hline z]; linarith [hline z]
    · simp
  exact reflectionForm_nonneg_of_fixed τ hfix m hm0 v

#print axioms GppQuartetIndex.quartet_negative_family
#print axioms GppQuartetIndex.offline_conditions
#print axioms GppQuartetIndex.negativeIndex_le_one_forces_line
#print axioms GppQuartetIndex.online_form_nonneg

end GppQuartetIndex
