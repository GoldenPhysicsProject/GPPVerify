import Mathlib.NumberTheory.ArithmeticFunction.VonMangoldt
import Mathlib.NumberTheory.ArithmeticFunction.Moebius
import Mathlib.Analysis.SpecialFunctions.Pow.Real

/-!
# The all-prime shift current `[D, Z_σ] Z_σ⁻¹ = Σ Λ(n) n^{-σ} S_n`

Source: Codex, GPP-bridge PR #11 comment 6138916828 and
`work/codex/2026-10-13_primitive_lattice_eisenstein_scattering_prime_current.md`. It continues
Daniel Toupin's additive-solenoid rational-height spectrum.

On `ℓ²(ℕ)` let `S_n e_m = e_{nm}` and `D e_m = (log m) e_m`. Since `S_n S_k = S_{nk}`, a series
`Σ a(n) S_n` multiplies like the Dirichlet convolution of its coefficients. So the operator
algebra generated by the `S_n` is the arithmetic-function ring, and `[D, ·]` acts on coefficients
as the pointwise product with `log`. In that algebra:
* `twist_mul`: the weight `n^{-σ}` is multiplicative, so twisting is a ring map.
* `pmul_log_mul`: pointwise `log` is a **derivation**, i.e. the commutator with `D`.
* `twist_zeta_mul_twist_moebius`: `Z_σ = Σ n^{-σ} S_n` has inverse `Σ μ(n) n^{-σ} S_n`.
* `prime_current`: **`(log·Z_σ) * Z_σ⁻¹ = Σ Λ(n) n^{-σ} S_n`** exactly, with every prime power and
  no truncation.
* `moebius_theta_finite`: the exact finite Möbius cancellation
  `Σ_{k≤N} (Σ_{d∣k} μ(d)) f(k) = f(1)`. Applied to `f(k) = 2e^{−πk²y²}` and summed absolutely, it
  gives Codex's `Σ_n μ(n)(Θ(ny) − 1) = 2e^{−πy²}`; that limit is not formalized here.

Codex's height–Eisenstein bridge `φ(w) = √π Γ(w−½)/(4Γ(w)) · [T(2w) + 2]` is a direct substitution
of `T(s) = 4ζ(s−1)/ζ(s) − 2` into the classical scattering coefficient. The log-derivative
`φ'/φ = ψ(w−½) − ψ(w) − 2Σ_{n≥2} Λ(n)(n−1)n^{−2w}` was checked numerically (residual 5·10⁻⁸ at
`w = 1.7`, equal to the truncation tail). **Not formalized:** the `ℓ²` operators themselves (they are
bounded for `σ > 1` because each `S_n` is an isometry and `Σ n^{−σ} < ∞`), the Eisenstein
coefficient, and the analytic continuation. Its poles at `w = ρ/2` are resonances, not eigenvalues.
**No RH claim.**
-/

namespace GppPrimeShiftCurrent

open ArithmeticFunction
open scoped ArithmeticFunction.Moebius ArithmeticFunction.zeta

/-- Weight the coefficients of an arithmetic function by `n^{-σ}`. -/
noncomputable def twist (σ : ℝ) (f : ArithmeticFunction ℝ) : ArithmeticFunction ℝ :=
  ⟨fun n => f n * (n : ℝ) ^ (-σ), by simp⟩

@[simp] theorem twist_apply (σ : ℝ) (f : ArithmeticFunction ℝ) (n : ℕ) :
    twist σ f n = f n * (n : ℝ) ^ (-σ) := rfl

/-- The weight `n^{-σ}` is completely multiplicative, so twisting respects convolution. -/
theorem twist_mul (σ : ℝ) (f g : ArithmeticFunction ℝ) :
    twist σ (f * g) = twist σ f * twist σ g := by
  ext n
  simp only [twist_apply, mul_apply, Finset.sum_mul]
  refine Finset.sum_congr rfl (fun p hp => ?_)
  have h := (Nat.mem_divisorsAntidiagonal.mp hp).1
  rw [← h]
  push_cast
  rw [Real.mul_rpow (Nat.cast_nonneg _) (Nat.cast_nonneg _)]
  ring

theorem twist_one (σ : ℝ) : twist σ 1 = 1 := by
  ext n
  rw [twist_apply, one_apply]
  split_ifs with h
  · simp [h]
  · simp

/-- **Pointwise `log` is a derivation of Dirichlet convolution** (the commutator with `D`). -/
theorem pmul_log_mul (f g : ArithmeticFunction ℝ) :
    pmul log (f * g) = pmul log f * g + f * pmul log g := by
  ext n
  simp only [pmul_apply, mul_apply, ArithmeticFunction.add_apply, Finset.mul_sum,
    ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl (fun p hp => ?_)
  obtain ⟨h, hn⟩ := Nat.mem_divisorsAntidiagonal.mp hp
  have ha : p.1 ≠ 0 := fun h0 => hn (by rw [← h, h0, zero_mul])
  have hb : p.2 ≠ 0 := fun h0 => hn (by rw [← h, h0, mul_zero])
  rw [← h, log_apply, log_apply, log_apply, Nat.cast_mul,
    Real.log_mul (by exact_mod_cast ha) (by exact_mod_cast hb)]
  ring

/-- `Z_σ = Σ n^{-σ} S_n` is inverted by `Σ μ(n) n^{-σ} S_n`. -/
theorem twist_zeta_mul_twist_moebius (σ : ℝ) :
    twist σ (ζ : ArithmeticFunction ℝ) * twist σ (μ : ArithmeticFunction ℝ) = 1 := by
  rw [← twist_mul, coe_zeta_mul_coe_moebius, twist_one]

/-- The commutator with `D` sends `Z_σ` to `Σ (log n) n^{-σ} S_n`. -/
theorem pmul_log_twist_zeta (σ : ℝ) :
    pmul log (twist σ (ζ : ArithmeticFunction ℝ)) = twist σ log := by
  ext n
  rw [pmul_apply, twist_apply, twist_apply, natCoe_apply, zeta_apply]
  split_ifs with h
  · simp [h]
  · simp

/-- **The all-prime current**: `[D, Z_σ] Z_σ⁻¹ = Σ Λ(n) n^{-σ} S_n`, exactly. -/
theorem prime_current (σ : ℝ) :
    pmul log (twist σ (ζ : ArithmeticFunction ℝ)) * twist σ (μ : ArithmeticFunction ℝ)
      = twist σ vonMangoldt := by
  rw [pmul_log_twist_zeta, ← twist_mul, ← vonMangoldt_mul_zeta, mul_assoc,
    coe_zeta_mul_coe_moebius, mul_one]

/-- **Exact finite Möbius cancellation**: `Σ_{k≤N} (Σ_{d∣k} μ d) f(k) = f(1)`. -/
theorem moebius_theta_finite (f : ℕ → ℝ) {N : ℕ} (hN : 1 ≤ N) :
    ∑ k ∈ Finset.Icc 1 N, (∑ d ∈ k.divisors, ((μ d : ℤ) : ℝ)) * f k = f 1 := by
  have hk : ∀ k, (∑ d ∈ k.divisors, ((μ d : ℤ) : ℝ)) = if k = 1 then 1 else 0 := by
    intro k
    have h := congrArg (fun F : ArithmeticFunction ℝ => F k)
      (coe_moebius_mul_coe_zeta (R := ℝ))
    simp only [coe_mul_zeta_apply, intCoe_apply, one_apply] at h
    exact h
  simp_rw [hk, ite_mul, one_mul, zero_mul]
  rw [Finset.sum_ite_eq' (Finset.Icc 1 N) 1 f, if_pos (Finset.mem_Icc.mpr ⟨le_rfl, hN⟩)]

end GppPrimeShiftCurrent
