/-- The rational floor constant `c_A`. -/
def cA : ℚ := 867483 / 500000
def piLo : ℚ := 314159265358979323846 / 10 ^ 20
def piHi : ℚ := 314159265358979323847 / 10 ^ 20
def log2Hi : ℚ := 6931471808 / 10 ^ 10

/-- Number of bits of `⌊4 π_hi j⌋`. -/
def mOf (j : ℕ) : ℕ := Nat.log2 (4 * 314159265358979323847 * j / 10 ^ 20) + 1

/-- `x = 1 − 4 π_hi j / 2ᵐ`. -/
def xq (j : ℕ) : ℚ := 1 - 4 * piHi * j / 2 ^ mOf j

/-- `Σ_{i<n} x^{i+1}/(i+1)`. -/
def ser : ℕ → ℚ → ℚ
  | 0, _ => 0
  | n + 1, x => ser n x + x ^ (n + 1) / (n + 1)

/-- Rational upper bound for `log (4 π_hi j)`. -/
def lUp (j : ℕ) : ℚ := mOf j * log2Hi - ser 24 (xq j) + 1 / 2 ^ 24

def aLo (j : ℕ) : ℚ := ((aLoNum.getD (j - 73) 0 : ℕ) : ℚ) / 2 ^ 160

def haOK (j : ℕ) : Bool :=
  decide (0 ≤ xq j ∧ xq j ≤ 1 / 2 ∧ cA * lUp j ≤ aLo j * (4 * piLo * j) ^ 4)

/-- **The finite kernel check**, `j = 73 … 812`. -/
theorem haOK_all : (List.range' 73 740).all haOK = true := by decide +kernel

theorem haOK_of_range {j : ℕ} (hj : 73 ≤ j) (hj2 : j ≤ 812) :
    0 ≤ xq j ∧ xq j ≤ 1 / 2 ∧ cA * lUp j ≤ aLo j * (4 * piLo * j) ^ 4 := by
  have h := List.all_eq_true.mp haOK_all j (by rw [List.mem_range'_1]; omega)
  simpa [haOK] using h

theorem ser_cast (n : ℕ) (x : ℚ) :
    ((ser n x : ℚ) : ℝ) = ∑ i ∈ Finset.range n, (x : ℝ) ^ (i + 1) / (i + 1) := by
  induction n with
  | zero => simp [ser]
  | succ n ih =>
    rw [Finset.sum_range_succ, ← ih]
    simp [ser]

theorem tail_le {x : ℝ} (h0 : 0 ≤ x) (h1 : x ≤ 1 / 2) :
    x ^ (24 + 1) / (1 - x) ≤ 1 / 2 ^ 24 := by
  have hx : 0 < 1 - x := by linarith
  rw [div_le_iff₀ hx]
  have : x ^ (24 + 1) ≤ (1 / 2) ^ (24 + 1) := pow_le_pow_left₀ h0 h1 _
  have h2 : (1 / 2 : ℝ) ^ (24 + 1) = 1 / 2 ^ 24 * (1 / 2) := by norm_num
  nlinarith [h2, show (0 : ℝ) < 1 / 2 ^ 24 by positivity]

theorem log_le (j : ℕ) (hj : 73 ≤ j) (hj2 : j ≤ 812) :
    Real.log (4 * Real.pi * j) ≤ (lUp j : ℝ) := by
  obtain ⟨hx0, hx1, -⟩ := haOK_of_range hj hj2
  set m := mOf j with hm
  have hj0 : (0 : ℝ) < j := by exact_mod_cast (by omega : 0 < j)
  have hpiHi : ((piHi : ℚ) : ℝ) = 3.14159265358979323847 := by norm_num [piHi]
  have hpi := Real.pi_lt_d20
  have hpi0 := Real.pi_pos
  set W : ℝ := 4 * ((piHi : ℚ) : ℝ) * j with hW
  have hW0 : 0 < W := by rw [hW, hpiHi]; positivity
  have hωW : 4 * Real.pi * j ≤ W := by
    rw [hW, hpiHi]; nlinarith
  have hx : ((xq j : ℚ) : ℝ) = 1 - W / 2 ^ m := by
    simp [xq, hW, ← hm]
  have hx0' : (0 : ℝ) ≤ ((xq j : ℚ) : ℝ) := by exact_mod_cast hx0
  have hx1' : ((xq j : ℚ) : ℝ) ≤ 1 / 2 := by
    have := (Rat.cast_le (K := ℝ)).mpr hx1
    push_cast at this
    exact this
  set x : ℝ := ((xq j : ℚ) : ℝ) with hxdef
  have h2m : (0 : ℝ) < 2 ^ m := by positivity
  have hWx : W = 2 ^ m * (1 - x) := by
    rw [hx]; field_simp; ring
  have hx_pos : 0 < 1 - x := by linarith
  have hlogW : Real.log W = m * Real.log 2 + Real.log (1 - x) := by
    rw [hWx, Real.log_mul h2m.ne' hx_pos.ne', Real.log_pow]
  have habs := Real.abs_log_sub_add_sum_range_le (x := x) (by rw [abs_of_nonneg hx0']; linarith) 24
  rw [abs_of_nonneg hx0'] at habs
  have hlog1 : Real.log (1 - x) ≤ -(∑ i ∈ Finset.range 24, x ^ (i + 1) / (i + 1)) + 1 / 2 ^ 24 := by
    have := (abs_le.mp habs).2
    have := tail_le hx0' hx1'
    linarith
  have hl2 : Real.log 2 ≤ ((log2Hi : ℚ) : ℝ) := by
    have := Real.log_two_lt_d9
    have e : ((log2Hi : ℚ) : ℝ) = 0.6931471808 := by norm_num [log2Hi]
    rw [e]; exact this.le
  have hm0 : (0 : ℝ) ≤ m := Nat.cast_nonneg m
  have hLup : (lUp j : ℝ) = m * ((log2Hi : ℚ) : ℝ)
      - ∑ i ∈ Finset.range 24, x ^ (i + 1) / (i + 1) + 1 / 2 ^ 24 := by
    simp only [lUp, hxdef]
    push_cast
    rw [ser_cast]
  calc Real.log (4 * Real.pi * j) ≤ Real.log W :=
        Real.log_le_log (by positivity) hωW
    _ = m * Real.log 2 + Real.log (1 - x) := hlogW
    _ ≤ (lUp j : ℝ) := by
        rw [hLup]; nlinarith [mul_le_mul_of_nonneg_left hl2 hm0]

/-- **(H-A) on `73 ≤ j ≤ 812`.** If a real `a` is at least the exported lower endpoint
`aLo j = (cen_j − rad_j)/2¹⁶⁰`, then `c_A · log (4π j) / (4π j)⁴ ≤ a`. The hypothesis `aLo j ≤ A_jj`
(Flint's ball) is *not* proved here. -/
theorem floor_of_lower_endpoint (j : ℕ) (hj : 73 ≤ j) (hj2 : j ≤ 812) (a : ℝ)
    (ha : (aLo j : ℝ) ≤ a) :
    (cA : ℝ) * Real.log (4 * Real.pi * j) / (4 * Real.pi * j) ^ 4 ≤ a := by
  obtain ⟨-, -, hmain⟩ := haOK_of_range hj hj2
  have hmain' : (cA : ℝ) * (lUp j : ℝ) ≤ (aLo j : ℝ) * (4 * ((piLo : ℚ) : ℝ) * j) ^ 4 := by
    exact_mod_cast hmain
  have hj0 : (0 : ℝ) < j := by exact_mod_cast (by omega : 0 < j)
  have hpiLo : ((piLo : ℚ) : ℝ) = 3.14159265358979323846 := by norm_num [piLo]
  have hpi := Real.pi_gt_d20
  have hωpos : 0 < 4 * Real.pi * j := by positivity
  have hwlo : 4 * ((piLo : ℚ) : ℝ) * j ≤ 4 * Real.pi * j := by
    rw [hpiLo]; nlinarith
  have hwlo0 : 0 ≤ 4 * ((piLo : ℚ) : ℝ) * j := by rw [hpiLo]; positivity
  have hp4 : (4 * ((piLo : ℚ) : ℝ) * j) ^ 4 ≤ (4 * Real.pi * j) ^ 4 :=
    pow_le_pow_left₀ hwlo0 hwlo 4
  have haLo0 : (0 : ℝ) ≤ (aLo j : ℝ) := by
    have : (0 : ℚ) ≤ aLo j := by unfold aLo; positivity
    exact_mod_cast this
  have ha0 : 0 ≤ a := haLo0.trans ha
  have hcA : (0 : ℝ) ≤ (cA : ℝ) := by norm_num [cA]
  rw [div_le_iff₀ (by positivity)]
  calc (cA : ℝ) * Real.log (4 * Real.pi * j) ≤ (cA : ℝ) * (lUp j : ℝ) :=
        mul_le_mul_of_nonneg_left (log_le j hj hj2) hcA
    _ ≤ (aLo j : ℝ) * (4 * ((piLo : ℚ) : ℝ) * j) ^ 4 := hmain'
    _ ≤ a * (4 * Real.pi * j) ^ 4 :=
        mul_le_mul ha hp4 (by positivity) ha0

end GppWeilHA

