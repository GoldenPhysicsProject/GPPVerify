/-- **Obligation 2.** The true Gram determinant is at least half the rational one. -/
theorem determinant_transfer_bound :
    (d_rat : ℝ) / 2 ≤ ⟪o1, o1⟫_ℝ * ⟪o2, o2⟫_ℝ - ⟪o1, o2⟫_ℝ ^ 2 ∧ 0 < (d_rat : ℝ) / 2 := by
  have hd := approx_d h
  unfold Approx at hd
  have h1 : ((1 / 10 ^ 24 : ℚ) : ℝ) ≤ (d_rat : ℝ) / 2 := by
    have : (1 / 10 ^ 24 : ℚ) ≤ d_rat / 2 := by aug2_num
    exact_mod_cast this
  have h2 : (0 : ℝ) < (d_rat : ℝ) / 2 := by
    have : (0 : ℚ) < d_rat / 2 := by aug2_num
    exact_mod_cast this
  constructor
  · have := neg_abs_le (⟪o1, o1⟫_ℝ * ⟪o2, o2⟫_ℝ - ⟪o1, o2⟫_ℝ ^ 2 - (d_rat : ℝ))
    linarith
  · exact h2

theorem det_ne_zero : ⟪o1, o1⟫_ℝ * ⟪o2, o2⟫_ℝ - ⟪o1, o2⟫_ℝ ^ 2 ≠ 0 := by
  obtain ⟨h1, h2⟩ := determinant_transfer_bound h
  linarith

theorem A_ne_zero : ⟪o1, o1⟫_ℝ ≠ 0 := by
  have hA := approx_A h
  unfold Approx at hA
  have : ((1 / 10 ^ 19 : ℚ) : ℝ) < (A_rat : ℝ) := by
    have : (1 / 10 ^ 19 : ℚ) < A_rat := by aug2_num
    exact_mod_cast this
  have := neg_abs_le (⟪o1, o1⟫_ℝ - (A_rat : ℝ))
  intro h0; linarith

theorem norm_o1_le : ‖o1‖ ≤ ((116 / 10 ^ 5 : ℚ) : ℝ) := by
  refine norm_le_of_sq (x := o1) (by positivity) ?_
  have hA := approx_A h
  unfold Approx at hA
  have : (A_rat : ℝ) + ((1 / 10 ^ 19 : ℚ) : ℝ) ≤ ((116 / 10 ^ 5 : ℚ) : ℝ) ^ 2 := by
    have : A_rat + 1 / 10 ^ 19 ≤ (116 / 10 ^ 5 : ℚ) ^ 2 := by aug2_num
    exact_mod_cast this
  linarith [le_abs_self (⟪o1, o1⟫_ℝ - (A_rat : ℝ))]

theorem norm_o2_le : ‖o2‖ ≤ ((207 / 10 ^ 6 : ℚ) : ℝ) := by
  refine norm_le_of_sq (x := o2) (by positivity) ?_
  have hC := approx_C h
  unfold Approx at hC
  have : (C_rat : ℝ) + ((1 / 10 ^ 19 : ℚ) : ℝ) ≤ ((207 / 10 ^ 6 : ℚ) : ℝ) ^ 2 := by
    have : C_rat + 1 / 10 ^ 19 ≤ (207 / 10 ^ 6 : ℚ) ^ 2 := by aug2_num
    exact_mod_cast this
  linarith [le_abs_self (⟪o2, o2⟫_ℝ - (C_rat : ℝ))]

end Obligations

/-- A vector entrywise within `10⁻¹⁷` of zero has norm at most `4·10⁻¹⁷`. -/
theorem norm_le_of_entrywise {w : EuclideanSpace ℝ (Fin 13)}
    (hw : ∀ i, |w i| ≤ (orb_err_bound : ℝ)) : ‖w‖ ≤ ((4 / 10 ^ 17 : ℚ) : ℝ) := by
  refine norm_le_of_sq (x := w) (by positivity) ?_
  rw [inner_eq_sum]
  calc ∑ i, w i * w i ≤ ∑ _i : Fin 13, (orb_err_bound : ℝ) ^ 2 := by
        apply Finset.sum_le_sum; intro i _
        rw [← sq, ← sq_abs]
        exact pow_le_pow_left₀ (abs_nonneg _) (hw i) 2
    _ ≤ _ := by
        simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        have : (13 : ℚ) * orb_err_bound ^ 2 ≤ (4 / 10 ^ 17) ^ 2 := by aug2_num
        exact_mod_cast this

/-- The rational orbitals, embedded in `ℝ¹³`. -/
noncomputable def orb1_real : EuclideanSpace ℝ (Fin 13) := WithLp.toLp 2 fun i => (orb1_rat i : ℝ)
noncomputable def orb2_real : EuclideanSpace ℝ (Fin 13) := WithLp.toLp 2 fun i => (orb2_rat i : ℝ)

theorem D_proj_rat_real_eq :
    D_proj_rat_real = (c1_rat : ℝ) • orb1_real + (c2_rat : ℝ) • orb2_real := by
  ext i; simp [D_proj_rat_real, orb1_real, orb2_real]

section Assembly

variable {D o1 o2 : EuclideanSpace ℝ (Fin 13)} (h : DataEnclosure D o1 o2)
include h

theorem proj2_eq :
    proj2 o1 o2 D =
      ((⟪o2, o2⟫_ℝ * ⟪o1, D⟫_ℝ - ⟪o1, o2⟫_ℝ * ⟪o2, D⟫_ℝ) /
        (⟪o1, o1⟫_ℝ * ⟪o2, o2⟫_ℝ - ⟪o1, o2⟫_ℝ ^ 2)) • o1 +
      ((⟪o1, o1⟫_ℝ * ⟪o2, D⟫_ℝ - ⟪o1, o2⟫_ℝ * ⟪o1, D⟫_ℝ) /
        (⟪o1, o1⟫_ℝ * ⟪o2, o2⟫_ℝ - ⟪o1, o2⟫_ℝ ^ 2)) • o2 := by
  have hP := InnerProductSpace.starProjection_span_pair o1 o2 D (det_ne_zero h)
  simp only at hP
  exact hP

/-- **Obligation 3.** The true two-vector projection is within `20 · D_err` of the exact
rational projection. -/
theorem projection_perturbation_bound :
    ‖proj2 o1 o2 D - D_proj_rat_real‖ ≤ (transfer_constant : ℝ) * (D_err_bound : ℝ) := by
  set c1t := (⟪o2, o2⟫_ℝ * ⟪o1, D⟫_ℝ - ⟪o1, o2⟫_ℝ * ⟪o2, D⟫_ℝ) /
    (⟪o1, o1⟫_ℝ * ⟪o2, o2⟫_ℝ - ⟪o1, o2⟫_ℝ ^ 2)
  set c2t := (⟪o1, o1⟫_ℝ * ⟪o2, D⟫_ℝ - ⟪o1, o2⟫_ℝ * ⟪o1, D⟫_ℝ) /
    (⟪o1, o1⟫_ℝ * ⟪o2, o2⟫_ℝ - ⟪o1, o2⟫_ℝ ^ 2)
  have h1 : |c1t - c1_rat| ≤ ((11 / 10 ^ 8 : ℚ) : ℝ) := approx_c1 h
  have h2 : |c2t - c2_rat| ≤ ((62 / 10 ^ 8 : ℚ) : ℝ) := approx_c2 h
  have hδ1 : ‖o1 - orb1_real‖ ≤ ((4 / 10 ^ 17 : ℚ) : ℝ) :=
    norm_le_of_entrywise fun i => by simpa [orb1_real] using h.horb1 i
  have hδ2 : ‖o2 - orb2_real‖ ≤ ((4 / 10 ^ 17 : ℚ) : ℝ) :=
    norm_le_of_entrywise fun i => by simpa [orb2_real] using h.horb2 i
  have e : proj2 o1 o2 D - D_proj_rat_real =
      (c1t - c1_rat) • o1 + (c1_rat : ℝ) • (o1 - orb1_real) +
        ((c2t - c2_rat) • o2 + (c2_rat : ℝ) • (o2 - orb2_real)) := by
    rw [proj2_eq h, D_proj_rat_real_eq]; module
  have key : (11 / 10 ^ 8 : ℚ) * (116 / 10 ^ 5) + |c1_rat| * (4 / 10 ^ 17) +
      ((62 / 10 ^ 8) * (207 / 10 ^ 6) + |c2_rat| * (4 / 10 ^ 17)) ≤
      transfer_constant * D_err_bound := by
    simp only [transfer_constant]; aug2_num
  rw [e]
  calc _ ≤ ‖(c1t - c1_rat) • o1 + (c1_rat : ℝ) • (o1 - orb1_real)‖ +
        ‖(c2t - c2_rat) • o2 + (c2_rat : ℝ) • (o2 - orb2_real)‖ := norm_add_le _ _
    _ ≤ (|c1t - c1_rat| * ‖o1‖ + |(c1_rat : ℝ)| * ‖o1 - orb1_real‖) +
        (|c2t - c2_rat| * ‖o2‖ + |(c2_rat : ℝ)| * ‖o2 - orb2_real‖) := by
        gcongr <;> (refine (norm_add_le _ _).trans ?_; rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs])
    _ ≤ (((11 / 10 ^ 8 : ℚ) : ℝ) * ((116 / 10 ^ 5 : ℚ) : ℝ) +
          |(c1_rat : ℝ)| * ((4 / 10 ^ 17 : ℚ) : ℝ)) +
        (((62 / 10 ^ 8 : ℚ) : ℝ) * ((207 / 10 ^ 6 : ℚ) : ℝ) +
          |(c2_rat : ℝ)| * ((4 / 10 ^ 17 : ℚ) : ℝ)) := by
        gcongr
        · exact norm_o1_le h
        · exact norm_o2_le h
    _ ≤ _ := by exact_mod_cast key

/-- **Obligation 4: the assembly.** From the data enclosures alone: the AUG2 residue is below
`8.1·10⁻⁶`, the AUG1 residue below `1.6·10⁻⁴`, and both Cramer coefficients lie in intervals
that exclude `1`: `c₁ ∈ [1.006, 1.007]`, `c₂ ∈ [0.997, 0.998]`. -/
theorem aug2_certification_assembly :
    ‖D - proj2 o1 o2 D‖ ≤ (target_aug2_upper : ℝ) ∧
    ‖D - proj1 o1 D‖ ≤ (target_aug1_upper : ℝ) ∧
    (c1_lower : ℝ) ≤ (⟪o2, o2⟫_ℝ * ⟪o1, D⟫_ℝ - ⟪o1, o2⟫_ℝ * ⟪o2, D⟫_ℝ) /
        (⟪o1, o1⟫_ℝ * ⟪o2, o2⟫_ℝ - ⟪o1, o2⟫_ℝ ^ 2) ∧
    (⟪o2, o2⟫_ℝ * ⟪o1, D⟫_ℝ - ⟪o1, o2⟫_ℝ * ⟪o2, D⟫_ℝ) /
        (⟪o1, o1⟫_ℝ * ⟪o2, o2⟫_ℝ - ⟪o1, o2⟫_ℝ ^ 2) ≤ (c1_upper : ℝ) ∧
    (c2_lower : ℝ) ≤ (⟪o1, o1⟫_ℝ * ⟪o2, D⟫_ℝ - ⟪o1, o2⟫_ℝ * ⟪o1, D⟫_ℝ) /
        (⟪o1, o1⟫_ℝ * ⟪o2, o2⟫_ℝ - ⟪o1, o2⟫_ℝ ^ 2) ∧
    (⟪o1, o1⟫_ℝ * ⟪o2, D⟫_ℝ - ⟪o1, o2⟫_ℝ * ⟪o1, D⟫_ℝ) /
        (⟪o1, o1⟫_ℝ * ⟪o2, o2⟫_ℝ - ⟪o1, o2⟫_ℝ ^ 2) ≤ (c2_upper : ℝ) ∧
    1 < c1_lower ∧ c2_upper < 1 := by
  have sqle : ∀ {x : EuclideanSpace ℝ (Fin 13)} {r : ℚ}, 0 ≤ r → ‖x‖ ^ 2 ≤ (r : ℝ) ^ 2 →
      ‖x‖ ≤ r := fun hr hx =>
    (pow_le_pow_iff_left₀ (norm_nonneg _) (by exact_mod_cast hr) two_ne_zero).mp hx
  have hr2 := approx_res2 h
  have hr1 := approx_res1 h
  have hc1 := approx_c1 h
  have hc2 := approx_c2 h
  unfold Approx at hr2 hr1 hc1 hc2
  rw [abs_le] at hr2 hr1 hc1 hc2
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, by simp only [c1_lower]; norm_num,
    by simp only [c2_upper]; norm_num⟩
  · apply sqle (by simp only [target_aug2_upper]; norm_num)
    have hsq := InnerProductSpace.norm_sub_starProjection_span_pair_sq o1 o2 D (det_ne_zero h)
    simp only at hsq
    unfold proj2
    rw [hsq, ← real_inner_self_eq_norm_sq]
    have : (DD_rat - (C_rat * (p_rat * p_rat) - (2 * B_rat) * (p_rat * q_rat) +
        A_rat * (q_rat * q_rat)) / d_rat) + 7 / 10 ^ 13 ≤ target_aug2_upper ^ 2 := by
      simp only [target_aug2_upper]; aug2_num
    have : ((DD_rat - (C_rat * (p_rat * p_rat) - (2 * B_rat) * (p_rat * q_rat) +
        A_rat * (q_rat * q_rat)) / d_rat : ℚ) : ℝ) + ((7 / 10 ^ 13 : ℚ) : ℝ) ≤
        (target_aug2_upper : ℝ) ^ 2 := by exact_mod_cast this
    linarith [hr2.2]
  · apply sqle (by simp only [target_aug1_upper]; norm_num)
    rw [norm_sub_proj1_sq o1 D (A_ne_zero h)]
    have : (DD_rat - (p_rat * p_rat) / A_rat) + 3 / 10 ^ 13 ≤ target_aug1_upper ^ 2 := by
      simp only [target_aug1_upper]; aug2_num
    have : ((DD_rat - (p_rat * p_rat) / A_rat : ℚ) : ℝ) + ((3 / 10 ^ 13 : ℚ) : ℝ) ≤
        (target_aug1_upper : ℝ) ^ 2 := by exact_mod_cast this
    linarith [hr1.2]
  · have : c1_lower ≤ c1_rat - 11 / 10 ^ 8 := by simp only [c1_lower]; aug2_num
    have : (c1_lower : ℝ) ≤ (c1_rat : ℝ) - ((11 / 10 ^ 8 : ℚ) : ℝ) := by exact_mod_cast this
    linarith [hc1.1]
  · have : c1_rat + 11 / 10 ^ 8 ≤ c1_upper := by simp only [c1_upper]; aug2_num
    have : (c1_rat : ℝ) + ((11 / 10 ^ 8 : ℚ) : ℝ) ≤ (c1_upper : ℝ) := by exact_mod_cast this
    linarith [hc1.2]
  · have : c2_lower ≤ c2_rat - 62 / 10 ^ 8 := by simp only [c2_lower]; aug2_num
    have : (c2_lower : ℝ) ≤ (c2_rat : ℝ) - ((62 / 10 ^ 8 : ℚ) : ℝ) := by exact_mod_cast this
    linarith [hc2.1]
  · have : c2_rat + 62 / 10 ^ 8 ≤ c2_upper := by simp only [c2_upper]; aug2_num
    have : (c2_rat : ℝ) + ((62 / 10 ^ 8 : ℚ) : ℝ) ≤ (c2_upper : ℝ) := by exact_mod_cast this
    linarith [hc2.2]

end Assembly

end GppVerify.Aug2
