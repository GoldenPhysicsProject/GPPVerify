/-! ### Interval enclosures -/

/-- `X` lies within `e` of the rational `x`. -/
def Approx (X : ℝ) (x e : ℚ) : Prop := |X - x| ≤ e

theorem Approx.weaken {X : ℝ} {x e e' : ℚ} (h : Approx X x e) (he : e ≤ e') : Approx X x e' :=
  h.trans (by exact_mod_cast he)

theorem Approx.add {X Y : ℝ} {x y e f : ℚ} (h₁ : Approx X x e) (h₂ : Approx Y y f) :
    Approx (X + Y) (x + y) (e + f) := by
  unfold Approx at *; push_cast
  calc |X + Y - (x + y)| = |(X - x) + (Y - y)| := by ring_nf
    _ ≤ |X - x| + |Y - y| := abs_add_le _ _
    _ ≤ _ := add_le_add h₁ h₂

theorem Approx.sub {X Y : ℝ} {x y e f : ℚ} (h₁ : Approx X x e) (h₂ : Approx Y y f) :
    Approx (X - Y) (x - y) (e + f) := by
  unfold Approx at *; push_cast
  calc |X - Y - (x - y)| = |(X - x) - (Y - y)| := by ring_nf
    _ ≤ |X - x| + |Y - y| := abs_sub _ _
    _ ≤ _ := add_le_add h₁ h₂

theorem abs_mul_sub_le (X Y x y e f : ℝ) (h₁ : |X - x| ≤ e) (h₂ : |Y - y| ≤ f) :
    |X * Y - x * y| ≤ |x| * f + |y| * e + e * f := by
  have he : 0 ≤ e := (abs_nonneg _).trans h₁
  have key : X * Y - x * y = x * (Y - y) + y * (X - x) + (X - x) * (Y - y) := by ring
  rw [key]
  calc _ ≤ |x * (Y - y)| + |y * (X - x)| + |(X - x) * (Y - y)| := abs_add_three _ _ _
    _ = |x| * |Y - y| + |y| * |X - x| + |X - x| * |Y - y| := by simp [abs_mul]
    _ ≤ _ := by gcongr

theorem Approx.mul {X Y : ℝ} {x y e f : ℚ} (h₁ : Approx X x e) (h₂ : Approx Y y f) :
    Approx (X * Y) (x * y) (|x| * f + |y| * e + e * f) := by
  unfold Approx at *; push_cast
  exact abs_mul_sub_le X Y x y e f h₁ h₂

theorem Approx.div {X Y : ℝ} {x y e f : ℚ} (h₁ : Approx X x e) (h₂ : Approx Y y f)
    (hy : f < |y|) :
    Approx (X / Y) (x / y) ((|x| * f + |y| * e) / (|y| * (|y| - f))) := by
  unfold Approx at *
  have hy' : (f : ℝ) < |(y : ℝ)| := by exact_mod_cast hy
  have hf : (0 : ℝ) ≤ f := (abs_nonneg _).trans h₂
  have hY : |(y : ℝ)| - f ≤ |Y| := by
    have := abs_sub_abs_le_abs_sub (y : ℝ) Y
    rw [abs_sub_comm] at this; linarith [abs_sub_comm Y (y : ℝ)]
  have hYpos : 0 < |Y| := by linarith
  have hy0 : (y : ℝ) ≠ 0 := by intro h; rw [h, abs_zero] at hy'; linarith
  have hY0 : Y ≠ 0 := abs_pos.mp hYpos
  have key : X / Y - x / y = (y * (X - x) - x * (Y - y)) / (Y * y) := by
    field_simp; ring
  push_cast
  rw [key, abs_div, abs_mul, div_le_div_iff₀ (mul_pos hYpos (by linarith)) (mul_pos (by linarith) (by linarith))]
  have hnum : |(y : ℝ) * (X - x) - x * (Y - y)| ≤ |(x : ℝ)| * f + |(y : ℝ)| * e := by
    calc _ ≤ |(y : ℝ) * (X - x)| + |(x : ℝ) * (Y - y)| := abs_sub _ _
      _ = |(y : ℝ)| * |X - x| + |(x : ℝ)| * |Y - y| := by simp [abs_mul]
      _ ≤ |(y : ℝ)| * e + |(x : ℝ)| * f := by gcongr
      _ = _ := by ring
  calc |(y : ℝ) * (X - x) - x * (Y - y)| * (|(y : ℝ)| * (|(y : ℝ)| - f))
      ≤ (|(x : ℝ)| * f + |(y : ℝ)| * e) * (|Y| * |(y : ℝ)|) := by
        have he : (0 : ℝ) ≤ e := (abs_nonneg _).trans h₁
        apply mul_le_mul hnum _ (by nlinarith) (by positivity)
        nlinarith [abs_nonneg (y : ℝ)]

/-! ### Enclosures of inner products -/

theorem inner_eq_sum (u v : EuclideanSpace ℝ (Fin 13)) : ⟪u, v⟫_ℝ = ∑ i, u i * v i := by
  simp [PiLp.inner_apply, mul_comm]

theorem inner_approx (u v : EuclideanSpace ℝ (Fin 13)) (a b : Fin 13 → ℚ) (eu ev : ℚ)
    (hu : ∀ i, |u i - a i| ≤ eu) (hv : ∀ i, |v i - b i| ≤ ev) :
    Approx ⟪u, v⟫_ℝ (dotQ a b)
      ((∑ i, |a i|) * ev + (∑ i, |b i|) * eu + 13 * (eu * ev)) := by
  unfold Approx dotQ
  rw [inner_eq_sum]
  push_cast
  rw [← Finset.sum_sub_distrib]
  calc |∑ i, (u i * v i - a i * b i)| ≤ ∑ i, |u i * v i - (a i : ℝ) * b i| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i, (|(a i : ℝ)| * ev + |(b i : ℝ)| * eu + eu * ev) :=
        Finset.sum_le_sum fun i _ => abs_mul_sub_le _ _ _ _ _ _ (hu i) (hv i)
    _ = _ := by
        rw [Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.sum_mul, ← Finset.sum_mul]
        simp

