    Fin.sum_univ_succ, Fin.sum_univ_zero, orb1_rat, orb2_rat, D_rat, orb_err_bound,
    D_err_bound, Matrix.cons_val_zero, Matrix.cons_val_succ]
  norm_num [abs_of_neg, abs_of_pos]))

