/-! ### Projections, in the tree's `starProjection` form (#512) -/

/-- Projection onto `span {u, v}`. -/
noncomputable def proj2 (u v x : EuclideanSpace ℝ (Fin 13)) : EuclideanSpace ℝ (Fin 13) :=
  (span ℝ ({u, v} : Set (EuclideanSpace ℝ (Fin 13)))).starProjection x

/-- Projection onto `span {u}`. -/
noncomputable def proj1 (u x : EuclideanSpace ℝ (Fin 13)) : EuclideanSpace ℝ (Fin 13) :=
  (span ℝ ({u} : Set (EuclideanSpace ℝ (Fin 13)))).starProjection x

/-- One-vector residual: `‖x - P_u x‖² = ‖x‖² - ⟪u, x⟫² / ‖u‖²`. -/
theorem norm_sub_proj1_sq (u x : EuclideanSpace ℝ (Fin 13)) (hu : ⟪u, u⟫_ℝ ≠ 0) :
    ‖x - proj1 u x‖ ^ 2 = ⟪x, x⟫_ℝ - ⟪u, x⟫_ℝ ^ 2 / ⟪u, u⟫_ℝ := by
  unfold proj1
  rw [starProjection_singleton (𝕜 := ℝ), norm_sub_sq_real, inner_smul_right, norm_smul,
    mul_pow, Real.norm_eq_abs, sq_abs, ← real_inner_self_eq_norm_sq,
    ← real_inner_self_eq_norm_sq, real_inner_comm x u]
  simp only [RCLike.ofReal_real_eq_id, id]
  field_simp
  ring

