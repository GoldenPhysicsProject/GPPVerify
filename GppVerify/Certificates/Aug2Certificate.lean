theorem norm_le_of_sq {x : EuclideanSpace ℝ (Fin 13)} {r : ℝ} (hr : 0 ≤ r)
    (hx : ⟪x, x⟫_ℝ ≤ r ^ 2) : ‖x‖ ≤ r := by
  rw [real_inner_self_eq_norm_sq] at hx
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) hr two_ne_zero).mp hx

